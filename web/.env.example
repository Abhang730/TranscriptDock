# Copy to web/.env.local
#
# NEXT_PUBLIC_* values are embedded in the browser bundle. Never place a
# service-role key, payment secret or JWT secret here.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@transcriptdock.example

# Supabase Auth (safe to expose). Leave blank to disable account features.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: required for account deletion via the Supabase admin API.
# Remove the NEXT_PUBLIC_ prefix — this must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only: internal FastAPI origin used by /api/* route handlers.
# Not exposed to the browser; the browser only talks to same-origin /api/*.
API_ORIGIN=http://127.0.0.1:8000
