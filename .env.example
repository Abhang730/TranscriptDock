# =============================================================================
# TranscriptDock environment template
# Copy the relevant values into api/.env (backend) and web/.env.local
# (frontend). Never commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (web/.env.local) — values prefixed NEXT_PUBLIC_ are visible to the
# browser. Never put a service-role or payment secret in a NEXT_PUBLIC_ value.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@transcriptdock.example

# Supabase Auth (browser-safe). Leave blank to disable account features; the
# demo single-video flow still works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: lets the BFF delete the auth user on account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only: internal FastAPI origin used by the Next.js route handlers.
API_ORIGIN=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# Backend (api/.env)
# -----------------------------------------------------------------------------
APP_ENV=development
APP_VERSION=0.3.0
SERVICE_NAME=transcriptdock-api

# Provider: only "demo" is implemented. Anything else fails closed.
DEMO_MODE=true
PROVIDER_NAME=demo
JOB_CONCURRENCY=3
ITEM_TIMEOUT_SECONDS=15

# Persistence: "memory" is for local/demo use only (data is lost on restart)
# and the API refuses to start with it when APP_ENV=production.
# "supabase" requires SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY.
STORE_BACKEND=memory

# Auth: supply SUPABASE_JWT_SECRET for HS256 tokens (legacy Supabase JWT
# secret), or just SUPABASE_URL to verify asymmetric tokens via JWKS.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=

# Entitlements (server-side source of truth).
# The ₹49 price (4900 paise) is fixed; credit quantities, batch limits and
# retention windows are provisional and may change before launch.
PACK_PRICE_PAISE=4900
PACK_CREDITS=50
FREE_CREDITS=20
FREE_BATCH_SIZE=5
PAID_BATCH_SIZE=25
MAX_BATCH_SIZE=50

# Payments (Razorpay Test Mode first). Leave blank to keep checkout disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Limits and retention
ANONYMOUS_SINGLE_PER_HOUR=10
PREVIEW_PER_HOUR=30
RETENTION_DAYS=30
JOB_RETENTION_DAYS=90

# Transport
CORS_ORIGINS=http://localhost:3000
# Set true only when the API is reachable exclusively through a trusted proxy
# (the Next.js BFF / Cloud Run), so X-Forwarded-For cannot be spoofed.
TRUST_PROXY_HEADERS=false
